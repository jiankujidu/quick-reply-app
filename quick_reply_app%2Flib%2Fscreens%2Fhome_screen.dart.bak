              final hex = c['hex']!;
              final isSelected = _selectedColor == hex;
              final color = _parseColor(hex);
              return GestureDetector(
                onTap: () => setState(() => _selectedColor = hex),
                child: Container(
                  width: 32, height: 32,
                  decoration: BoxDecoration(
                    color: color,
                    shape: BoxShape.circle,
                    border: isSelected ? Border.all(color: Colors.black

  // ====== 涓夋鍚戝 UI 鏂规硶 ======
  Widget _buildStepIndicator() {
    const steps = ['閫夋嫨绫诲瀷', '灏忕粍閫夋嫨', '鍚嶇О璁剧疆'];
    return Row(
      children: List.generate(steps.length, (i) {
        final stepNum = i + 1;
        final isActive = stepNum == _wizardStep;
        final isPassed = stepNum < _wizardStep;
        // Step 2 鍙湪 level=group 鏃舵樉绀?
        if (i == 1 && _selectedLevel != 'group') return const SizedBox.shrink();
        return Expanded(
          child: Row(
            children: [
              Container(
                width: 28, height: 28,
                decoration: BoxDecoration(
                  color: isActive || isPassed ? Colors.blue : Colors.grey[300],
                  shape: BoxShape.circle,
                ),
                child: Center(
                  child: isPassed
                      ? const Icon(Icons.check, color: Colors.white, size: 16)
                      : Text('${i + 1}', style: TextStyle(color: isActive ? Colors.white : Colors.grey[600], fontWeight: FontWeight.bold, fontSize: 12)),
                ),
              ),
              const SizedBox(width: 6),
              Expanded(child: Text(steps[i], style: TextStyle(fontSize: 12, color: isActive ? Colors.black : Colors.grey[600], fontWeight: isActive ? FontWeight.bold : FontWeight.normal), overflow: TextOverflow.ellipsis)),
              if (i < steps.length - 1) ...[
                const SizedBox(width: 8),
                Expanded(child: Container(height: 2, color: isPassed ? Colors.blue : Colors.grey[300])),
                const SizedBox(width: 8),
              ],
            ],
          ),
        );
      }),
    );
  }

