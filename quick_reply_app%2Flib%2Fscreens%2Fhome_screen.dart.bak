          ),
          const SizedBox(height: 8),
          const Text('鎻愮ず锛氬皬缁勮瘽鏈粎瀵硅灏忕粍鎴愬憳鍙', style: TextStyle(fontSize: 11, color: Colors.grey)),
        ],
      );
    }
    // Step 3: 鍚嶇О+棰滆壊
    return Column(
      key: const ValueKey('step3'),
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text('璁剧疆鍒嗙被鍚嶇О', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
        const SizedBox(height: 8),
        TextField(
          controller: _nameController,
          maxLength: 16,
          decoration: const InputDecoration(
            hintText: '杈撳叆鍒嗙被鍚嶇О锛堟渶澶?6瀛楋級',
