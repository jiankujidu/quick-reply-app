        Wrap(
          spacing: 8,
          runSpacing: 8,
          children: _presetColors.map((c) {
            final hex = c['hex']!;
            final isSelected = _selectedColor == hex;
            final color = _parseColor(hex);
            return GestureDetector(
              onTap: () => setState(() => _selectedColor = hex),
