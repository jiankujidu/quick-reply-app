          const SizedBox(height: 16),
          _buildTypeCard('company', '馃彚 鍏徃璇濇湳', '鍏ㄥ叕鍙稿彲瑙侊紝鐢辩鐞嗗憳缁熶竴绠＄悊', Colors.blue),
          const SizedBox(height: 12),
          _buildTypeCard('group', '馃懃 灏忕粍璇濇湳', '浠呮湰缁勬垚鍛樺彲瑙侊紝闇€閫夋嫨鎵€灞炲皬缁?, Colors.orange),
          const SizedBox(height: 12),
          _buildTypeCard('private', '馃懁 绉佷汉璇濇湳', '浠呰嚜宸卞彲瑙侊紝涓汉涓撳睘', Colors.green),
        ],
      );
    }
    // Step 2: 灏忕粍閫夋嫨锛堜粎 group 绾у埆锛?
    if (_wizardStep == 2 && _selectedLevel == 'group') {
      return Column(
        key: const ValueKey('step2'),
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text('閫夋嫨灏忕粍', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
          const SizedBox(height: 8),
